# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Server
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_PATH=./server/database/database.sqlite

# JWT
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHARS
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=REPLACE_WITH_ANOTHER_RANDOM_64_CHARS
REFRESH_TOKEN_EXPIRY=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM_NAME=Your Studio Name
SMTP_FROM_EMAIL=your_email@gmail.com

# Admin
ADMIN_EMAIL=your_email@gmail.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Session
SESSION_SECRET=REPLACE_WITH_RANDOM_STRING

# Google OAuth
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# File Uploads
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./server/uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_PUBLIC=100
RATE_LIMIT_MAX_AUTH=1000

# CORS
CORS_ORIGIN=http://localhost:3000
